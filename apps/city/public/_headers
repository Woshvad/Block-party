# Cache rules for a static host that reads _headers (Cloudflare Pages and
# Workers static assets, Netlify). Only content-versioned addresses are
# immutable, where a changed file always gets a new address: Next's hashed
# build files, and the kit packs, whose folders are named after a hash of
# their files (scripts/assets.mjs). Everything else keeps the host's default
# and is revalidated. next.config.mjs sends the same when Next serves the city.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/kenney/*
  Cache-Control: public, max-age=31536000, immutable
