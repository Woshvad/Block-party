// The live rooms Worker: one Durable Object per room copy, plus a directory
// per place. Deploy: pnpm --filter @bp/rooms build && wrangler deploy
// Secrets (wrangler secret put ...): TICKET_SECRET, INTERNAL_SECRET (both the
// same as the API's, 32+ characters). Optional: BLOCKED_WORDS, staff's blocked
// words for room chat, comma- or newline-separated (the same list as the API's).
// ACCESS_TTL_MS is for tests only. README "Deploying" describes each.
// OWNER ITEMS (placeholders, nothing here is real yet): the Cloudflare account
// and the domains. API_URL assumes https://api.blockparty.city, and the API's
// ROOMS_URL assumes https://rooms.blockparty.city.
{
  "name": "block-party-rooms",
  "main": "dist/worker.js",
  "no_bundle": true, // build.mjs bundles it (see the rooms tests)
  "build": { "command": "node build.mjs" },
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "DirectoryDO"] }],
  // OWNER ITEM: the rooms' custom domain, once the domain is on the account,
  // e.g. "routes": [{ "pattern": "<rooms domain>", "custom_domain": true }].
  "vars": { "API_URL": "https://api.blockparty.city" },
  "observability": { "enabled": true }
}
