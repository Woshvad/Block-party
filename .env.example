DATABASE_URL=postgres://localhost:5432/blockparty
TEST_DATABASE_URL=postgres://localhost:5432/blockparty_test
# Placeholders: the API won't start on these. README Setup has a line that
# makes local secrets; the bot token is your test bot's, or locally any
# made-up <digits>:<30+ letters, digits, - or _>.
TELEGRAM_BOT_TOKEN=123456:replace-me
INTERNAL_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
PORT=8787
# The live rooms locally: pnpm --filter @bp/rooms dev
ROOMS_URL=http://localhost:8788
TICKET_SECRET=replace-with-at-least-32-random-characters
# Proof of Neighbour: hashes phone numbers and wallets. The PoN routes answer
# 503 until a phone or crypto-proof provider is configured as well.
PON_PEPPER=replace-with-at-least-32-random-characters
# Workers: the city's https address. Pushes then carry an Open button to
# <CITY_URL>/?n=<id>, which opens the city and marks the push opened. Unset:
# plain-text pushes. (The local server sends no pushes.)
CITY_URL=
# Staff's blocked words for chat, comma- or newline-separated (the API and the
# local rooms both read it). Empty: no list.
BLOCKED_WORDS=
# Local dev: a sample odds feed, and the minute cron (bell, odds, Slate) in the Node server.
ODDS_SOURCE=mock
LOCAL_CRON=1
# Feature switches, as on Workers: "on" to enable locally.
FEATURE_DUELS=
FEATURE_TOWER_LIGHTS=
FEATURE_REAL_MONEY=
# The 15-minute warm-up: off until Polymarket's written OK and a legal check.
FEATURE_WARMUP=
# The AI moderation check. The local server reads it too: set, the minute
# cron (LOCAL_CRON=1) sends the moderation queue to OpenAI.
OPENAI_API_KEY=
# Set on Workers (wrangler secret put) and read only there; see README
# "Deploying". Leave them empty here: a value that is set must be a real one
# (RECEIPT_SECRET: 32+ characters).
RECEIPT_SECRET=
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# The city (apps/city) doesn't read this file: its NEXT_PUBLIC_ settings come
# from its own environment at build time. A production build needs
# NEXT_PUBLIC_API_URL set to the API's https:// address (README "Deploying").
# NEXT_PUBLIC_TG_APP_URL, the Mini App's own link (https://t.me/<bot>/<app>),
# makes crew invites Telegram links (?startapp=i-<code>).
# NEXT_PUBLIC_API_URL=https://<api domain>
# NEXT_PUBLIC_TG_APP_URL=https://t.me/<bot>/<app>
